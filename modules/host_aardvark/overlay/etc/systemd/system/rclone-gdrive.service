[Unit]
Description=rclone Google Drive live mount (streamed reads, prompt uploads)
Documentation=https://rclone.org/drive/
Wants=network-online.target
After=network-online.target
Before=umount.target

[Service]
RuntimeDirectory=rclone-gdrive
RuntimeDirectoryMode=0700
UMask=0077
Type=notify
User=root
Group=root

# Stale-mount cleanup before start and after stop
ExecStartPre=/bin/sh -c '/usr/bin/fusermount3 -uz /mnt/gdrive 2>/dev/null || true'
ExecStop=/usr/bin/fusermount3 -uz /mnt/gdrive

ExecStart=/usr/bin/rclone mount gdrive: /mnt/gdrive \
  --uid=1000 \
  --gid=1000 \
  --allow-other \
  --umask=022 \
  --vfs-cache-mode=writes \
  --vfs-cache-max-size=4G \
  --vfs-cache-max-age=5m \
  --vfs-cache-min-free-space=10G \
  --vfs-cache-poll-interval=30s \
  --cache-dir=/cache \
  --vfs-write-back=100ms \
  --vfs-handle-caching=1s \
  --vfs-read-chunk-size=16M \
  --vfs-read-chunk-streams=64 \
  --buffer-size=16M \
  --use-mmap \
  --max-read-ahead=1M \
  --dir-cache-time=1h \
  --attr-timeout=1s \
  --poll-interval=2s \
  --tpslimit=40 \
  --tpslimit-burst=40 \
  --transfers=16 \
  --drive-chunk-size=64M \
  --drive-pacer-min-sleep=25ms \
  --drive-use-trash=false \
  --no-checksum \
  --contimeout=15s \
  --timeout=60s \
  --retries=5 \
  --low-level-retries=10 \
  --daemon-timeout=60s \
  --rc \
  --rc-addr=unix:///run/rclone-gdrive/rc.sock \
  --log-level=INFO \
  --log-file=/var/log/rclone-gdrive.log


Restart=on-failure
RestartSec=10

AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_NICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
