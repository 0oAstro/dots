[Unit]
Description=rclone Dropbox live mount (streamed reads, prompt confirmed uploads)
Documentation=https://rclone.org/commands/rclone_mount/
Wants=network-online.target
After=network-online.target
Before=umount.target

[Service]
RuntimeDirectory=rclone-dropbox
RuntimeDirectoryMode=0700
UMask=0077
Type=notify
User=root
Group=root
ExecStartPre=/bin/sh -c '/usr/bin/fusermount3 -uz /mnt/dropbox 2>/dev/null || true'
ExecStop=/usr/bin/fusermount3 -uz /mnt/dropbox
ExecStart=/usr/bin/rclone mount dropbox: /mnt/dropbox \
  --uid=1000 \
  --gid=1000 \
  --allow-other \
  --umask=022 \
  --vfs-cache-mode=writes \
  --vfs-cache-max-size=4G \
  --vfs-cache-max-age=5m \
  --vfs-cache-min-free-space=10G \
  --vfs-cache-poll-interval=30s \
  --cache-dir=/cache \
  --vfs-write-back=100ms \
  --vfs-handle-caching=1s \
  --vfs-read-chunk-size=16M \
  --vfs-read-chunk-streams=32 \
  --buffer-size=16M \
  --max-read-ahead=1M \
  --use-mmap \
  --dir-cache-time=1h \
  --attr-timeout=1s \
  --poll-interval=2s \
  --transfers=16 \
  --tpslimit=40 \
  --tpslimit-burst=40 \
  --dropbox-chunk-size=96M \
  --dropbox-batch-mode=sync \
  --dropbox-batch-size=16 \
  --dropbox-batch-timeout=200ms \
  --no-checksum \
  --contimeout=15s \
  --timeout=60s \
  --retries=5 \
  --low-level-retries=10 \
  --daemon-timeout=60s \
  --rc \
  --rc-addr=unix:///run/rclone-dropbox/rc.sock \
  --log-level=INFO \
  --log-file=/var/log/rclone-dropbox.log

Restart=on-failure
RestartSec=10
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_NICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
