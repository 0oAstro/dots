[Unit]
Description=Collect AlgoChat ads export health for Prometheus
After=user@1000.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/docker/prometheus/algochat-ads/monitor.py collect
TimeoutStartSec=30s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/node_exporter/textfile_collector
