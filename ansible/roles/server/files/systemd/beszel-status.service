[Unit]
Description=Publish sanitized Beszel resource status for Glance
After=beszel.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/docker/glance/ops/publish-beszel-status.py
User=root
Group=docker
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/docker/beszel/data
ReadWritePaths=/opt/docker/glance/assets
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
