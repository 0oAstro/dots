[Unit]
Description=Encrypted Docker recovery backups to S3 and Google Drive
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/flock -n /run/lock/docker-backup.lock /usr/local/lib/docker-backup/python3 /opt/docker/backup/backup.py backup
TimeoutStartSec=4h
TimeoutStopSec=60s
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
