[Unit]
Description=Export AWS EBS CloudWatch metrics for Prometheus node_exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=AWS_DEFAULT_REGION=ap-south-1
Environment=AWS_EC2_METADATA_DISABLED=false
ExecStart=/opt/docker/prometheus/ebs-cloudwatch-exporter.py --config /opt/docker/prometheus/ebs-cloudwatch-exporter.json --output /var/lib/node_exporter/textfile_collector/ebs_cloudwatch.prom
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/node_exporter/textfile_collector
