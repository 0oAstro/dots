<?xml version="1.0" encoding="utf-8"?>
<direct>
  <chain ipv="ipv4" table="filter" chain="DOCKER-USER"/>
  <!-- IMDS hop limit is 2 for Bifrost's Bedrock role; every other forwarded source (containers, exit-node clients) is refused. -->
  <rule ipv="ipv4" table="filter" chain="DOCKER-USER" priority="-2">-d 169.254.169.254/32 '!' -s 172.21.0.10 -j REJECT</rule>
  <!-- t3 listens on 0.0.0.0:3773 for its T3 Connect tunnel (loopback) and Caddy (pinned 172.28.0.5 on auth_net) only. -->
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="-2">-p tcp --dport 3773 -s 127.0.0.0/8 -j ACCEPT</rule>
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="-2">-p tcp --dport 3773 -s 172.28.0.5 -j ACCEPT</rule>
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="-1">-p tcp --dport 3773 -j REJECT --reject-with tcp-reset</rule>
  <!-- Tailnet and exit-node clients reach published ports (DNAT) and replies only, never container IPs. -->
  <rule ipv="ipv4" table="filter" chain="DOCKER-USER" priority="10">-i tailscale0 -m conntrack --ctstate DNAT -j ACCEPT</rule>
  <rule ipv="ipv4" table="filter" chain="DOCKER-USER" priority="11">-i tailscale0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT</rule>
  <rule ipv="ipv4" table="filter" chain="DOCKER-USER" priority="93">-i tailscale0 -o docker0 -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="DOCKER-USER" priority="94">-i tailscale0 -o br-+ -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="DOCKER-USER" priority="90">-i ens34 -m conntrack --ctstate DNAT -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="DOCKER-USER" priority="91">-i ens34 -o docker0 -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="DOCKER-USER" priority="92">-i ens34 -o br-+ -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="DOCKER-USER" priority="-1">-i ens34 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT</rule>
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="0">-i tailscale0 -p tcp --dport 111 '!' -s 100.81.80.94 -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="0">-i tailscale0 -p udp --dport 111 '!' -s 100.81.80.94 -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="0">-i tailscale0 -p tcp --dport 2049 '!' -s 100.81.80.94 -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="0">-i tailscale0 -p udp --dport 2049 '!' -s 100.81.80.94 -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="0">-i tailscale0 -p tcp --dport 20048 '!' -s 100.81.80.94 -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="0">-i tailscale0 -p udp --dport 20048 '!' -s 100.81.80.94 -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="0">-i tailscale0 -p tcp --dport 56177 '!' -s 100.81.80.94 -j DROP</rule>
  <rule ipv="ipv4" table="filter" chain="INPUT" priority="0">-i tailscale0 -p udp --dport 56177 '!' -s 100.81.80.94 -j DROP</rule>
</direct>
