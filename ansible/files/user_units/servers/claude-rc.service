[Unit]
Description=Claude Code Remote Control in the home directory
After=network-online.target

[Service]
WorkingDirectory=%h
# .zshenv puts the mise-managed claude on PATH; a login-free, non-interactive
# zsh exports only the .zshenv allowlist, not every key in agents.env.
ExecStart=/usr/bin/zsh -c 'claude remote-control --name home'
KillSignal=SIGINT
TimeoutStopSec=20
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
