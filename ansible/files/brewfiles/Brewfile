# Every Mac: apps and the few formulae mise can't provide. CLI tools belong in
# ~/.config/mise/conf.d. The homebrew role appends <host>.Brewfile, and
# anything installed but listed in neither gets uninstalled.

tap "abue-ammar/tinycast", trusted: true
tap "henrygd/beszel"

brew "btop"
brew "gcc"
brew "mas"  # App Store apps below; needs an App Store sign-in
brew "mole"  # deep clean and optimize the Mac
brew "zsh"

# Beszel agent, reporting to beszel.shau.me on aardvark. Env: ~/.config/beszel.
# macmon (GPU) and smartmontools (S.M.A.R.T.) must be on the service PATH.
brew "henrygd/beszel/beszel-agent", trusted: true, restart_service: :changed
brew "macmon"
brew "smartmontools"

cask "ghostty"
cask "cursor"
cask "chatgpt"  # also runs Codex's app-server and computer use
cask "abue-ammar/tinycast/tinycast"  # launcher, hotkeys, clipboard history
cask "tailscale-app"
cask "rustdesk"
cask "blip"

cask "helium-browser"
cask "iina"
cask "obsidian"
cask "slack"
cask "steam"
cask "t3-code"
cask "whatsapp"

mas "Bitwarden", id: 1352778147
mas "uBlock Origin Lite", id: 6745342698
mas "TestFlight", id: 899247664
mas "Numbers", id: 361304891
mas "Xcode", id: 497799835
