# What a module leaves behind on a host that is not in it: its `remove`
# paths, and its fonts.
{{- template "module-paths" (dict "key" "remove" "ctx" .) }}
{{- $fonts := ternary "Library/Fonts" ".local/share/fonts" (eq .chezmoi.os "darwin") }}
{{- range includeTemplate "module-paths" (dict "key" "fonts" "ctx" .) | trim | splitList "\n" | compact }}
{{ $fonts }}/{{ . }}
{{- end }}

