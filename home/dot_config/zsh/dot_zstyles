#
# .zstyles — zstyle settings for completion, history, plugins, antidote
#

# ── antidote ─────────────────────────────────────────────────────
zstyle ':antidote:home'  path "$ANTIDOTE_HOME"
zstyle ':antidote:repo'  path "$ZDOTDIR/.antidote"
zstyle ':antidote:*'     zcompile 'yes'

# ── completion ───────────────────────────────────────────────────
zstyle ':completion:*' menu no
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose yes
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' completer _complete _ignored
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/.zcompcache"

zstyle ':completion:*' squeeze-slashes true
zstyle ':completion:*' special-dirs ..
zstyle ':completion:*:git-checkout:*' sort false

# fzf-tab-completion shows descriptions without changing zsh's candidates.
zstyle ':completion:*' fzf-search-display false
zstyle ':completion:*' fzf-completion-keybindings 'right:accept:repeat-fzf-completion'
