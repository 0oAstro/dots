#!/bin/sh
# Re-runs whenever a rendered mise module changes.
{{- range (glob (joinPath .chezmoi.sourceDir "private_dot_config/mise/conf.d/*")) }}
# {{ base . }}: {{ include . | sha256sum }}
{{- end }}
# ai={{ .ai }}
set -eu
mise=$HOME/.local/bin/mise
if [ ! -x "$mise" ]; then
  echo "dots: installing mise"
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$mise" sh
fi
# Runtimes first, then the rest with their shims on PATH: postinstall hooks
# (prime-agent runs npm) see this PATH, not the toolset's.
export PATH="$HOME/.local/share/mise/shims:$PATH"
"$mise" install --yes node python &&
  "$mise" install --yes || echo "dots: some mise tools failed; rerun 'mise install'" >&2
