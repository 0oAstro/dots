{{- if and .modules.ai .modules.server (ne .chezmoi.os "darwin") -}}
#!/bin/sh
# Starts Claude Remote Control on servers; restarts it when its unit changes.
# claude-rc: {{ include "private_dot_config/systemd/user/claude-rc.service" | sha256sum }}
set -eu
command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1 || {
  echo "dots: no systemd user session; start claude-rc yourself" >&2
  exit 0
}
unit=claude-rc.service
# Restart only if the unit file changed (systemd flags it before a reload),
# so a first apply on a configured machine leaves the running service alone.
changed=$(systemctl --user show -p NeedDaemonReload --value "$unit")
systemctl --user daemon-reload
systemctl --user enable --now "$unit"
[ "$changed" != yes ] || systemctl --user restart "$unit"
{{- end }}
