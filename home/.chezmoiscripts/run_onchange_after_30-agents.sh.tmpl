{{- if .ai -}}
#!/bin/bash
# Agent harness setup that is state, not config.
# pstack itself is mise's http:pstack (conf.d/ai.toml);
# Claude Code and Pi load it through links and settings chezmoi manages.
set -euo pipefail
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
export GIT_TERMINAL_PROMPT=0

pstack=$HOME/.local/share/mise/installs/http-pstack/latest/plugins/pstack/skills

# Drop links into the deleted pstack fork (~/.claude/pstack)
# and to skills pstack no longer ships.
for link in "$HOME"/.claude/skills/*; do
  [[ -L $link ]] || continue
  target=$(readlink "$link")
  [[ $target == ../pstack/skills/* || ($target == "$pstack"/* && ! -e $link) ]] && rm -f "$link"
done

# bifrost-mitm routes Claude Code's model calls through Bifrost.
command -v mitmdump >/dev/null || uv tool install --quiet mitmproxy

# Pi reaches Claude only through Bifrost (aardvark's claude-relay holds the one
# proxy token). Claude Code keeps its own per-machine login. Drop any Anthropic
# OAuth that Pi's /login stored so no third Claude token persists here.
# Bifrost requests use 1h prompt caching through the credential's env, which Pi
# reads ahead of the process environment.
pi_auth=$HOME/.pi/agent/auth.json
if [[ -f $pi_auth ]]; then
  python3 - "$pi_auth" <<'PY'
import json, os, sys
p = sys.argv[1]
d = json.load(open(p))
changed = d.pop("anthropic", None) is not None
if changed:
    print("dots: removed Pi's direct Anthropic login; Pi uses Bifrost", file=sys.stderr)
bifrost = d.get("bifrost")
if isinstance(bifrost, dict) and bifrost.get("env", {}).get("PI_CACHE_RETENTION") != "long":
    bifrost.setdefault("env", {})["PI_CACHE_RETENTION"] = "long"
    changed = True
if changed:
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, p)
PY
fi

{{- end }}
