{{- if .ai -}}
#!/bin/bash
# Agent harness setup that is state, not config: the pstack skill repos (each
# with its own history and sync tool), their skill links and extension deps.
# firecrawl-web lockfile: {{ include "dot_pi/private_agent/extensions/firecrawl-web/package-lock.json" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
export GIT_TERMINAL_PROMPT=0
status=0 # nonzero makes chezmoi rerun this script on the next apply

clone() { # repo dir [git clone args...]
  local repo=$1 dir=$2
  shift 2
  [[ -d $dir/.git ]] && return
  echo "dots: cloning $repo into $dir"
  git clone --quiet "$@" "https://github.com/$repo.git" "$dir" && return
  echo "dots: could not clone $repo (log in with 'gh auth login', then 'chezmoi apply')" >&2
  status=1
  return 1
}

link_skills() { # pstack checkout, skills dir
  local src=$1/skills dst=$2 skill link
  mkdir -p "$dst"
  for skill in "$src"/*/; do
    skill=$(basename "$skill")
    link=$dst/$skill
    [[ -e $link && ! -L $link ]] && continue
    ln -sfn "../pstack/skills/$skill" "$link"
  done
  # Drop links to skills pstack no longer ships.
  for link in "$dst"/*; do
    [[ -L $link && ! -e $link && $(readlink "$link") == ../pstack/skills/* ]] && rm -f "$link"
  done
  return 0
}

# A failed clone skips that harness's links; the rest still runs.
clone 0oAstro/pstack-claude "$HOME/.claude/pstack" && link_skills "$HOME/.claude/pstack" "$HOME/.claude/skills"
clone 0oAstro/pstack-codex "$HOME/.codex/pstack" && link_skills "$HOME/.codex/pstack" "$HOME/.codex/skills"

# Pi tracks cursor/plugins upstream; local edits live on 0oAstro/pstack-pi's portable branch.
pi_src=$HOME/.pi/agent/pstack-src
if [[ ! -d $pi_src/.git ]] &&
  clone 0oAstro/pstack-pi "$pi_src" --filter=blob:none --sparse --branch portable --origin preserve; then
  git -C "$pi_src" sparse-checkout set pstack
  git -C "$pi_src" remote add origin https://github.com/cursor/plugins.git
fi

ext=$HOME/.pi/agent/extensions/firecrawl-web
[[ -f $ext/package-lock.json ]] && (cd "$ext" && npm ci --silent --no-audit --no-fund)

# bifrost-mitm routes Claude Code's model calls through Bifrost.
command -v mitmdump >/dev/null || uv tool install --quiet mitmproxy

# Pi reaches Claude only through Bifrost (aardvark's claude-relay holds the one
# proxy token). Claude Code keeps its own per-machine login. Drop any Anthropic
# OAuth that Pi's /login stored so no third Claude token persists here.
pi_auth=$HOME/.pi/agent/auth.json
if [[ -f $pi_auth ]]; then
  python3 - "$pi_auth" <<'PY'
import json, os, sys
p = sys.argv[1]
d = json.load(open(p))
if d.pop("anthropic", None) is not None:
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, p)
    print("dots: removed Pi's direct Anthropic login; Pi uses Bifrost", file=sys.stderr)
PY
fi

exit $status
{{- end }}
