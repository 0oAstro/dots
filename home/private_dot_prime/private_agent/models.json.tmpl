{{- /* Prime reads apiKey as an environment-variable name. Bedrock remains excluded until its native signing passes an inference check. */ -}}
{{- $models := include "dot_pi/private_agent/models.json" | fromJson -}}
{{- $azure := $models.providers.azure -}}
{{- $cliproxy := $models.providers.cliproxy -}}
{{- $_ := set $azure "apiKey" "AZURE_OPENAI_API_KEY" -}}
{{- $_ := set $cliproxy "apiKey" "CLIPROXY_API_KEY" -}}
{{- toPrettyJson (dict "providers" (dict "azure" $azure "cliproxy" $cliproxy)) }}
