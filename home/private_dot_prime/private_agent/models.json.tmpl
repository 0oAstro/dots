{{- /* Pi's models.json, adjusted for Prime: Prime reads apiKey as a variable name and has no built-in azure provider. Prime gets only the Azure models: its Bedrock signing fails (InvalidSignatureException on every model, prime-agent 0.10.1). */ -}}
{{- $models := include "dot_pi/private_agent/models.json" | fromJson -}}
{{- $azure := $models.providers.azure -}}
{{- $_ := set $azure "apiKey" "AZURE_OPENAI_API_KEY" -}}
{{- toPrettyJson (dict "providers" (dict "azure" $azure)) }}
