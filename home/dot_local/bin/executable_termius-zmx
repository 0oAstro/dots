#!/bin/sh
# Termius/Mosh startup command.
# Keep the shell and its scrollback in one persistent zmx session.

# Mosh should normally set this, but forcing it avoids Termius profiles that
# advertise a minimal terminal type and consequently disable colors.
export TERM=xterm-256color
# Termius iOS renders ANSI 16/256 colors reliably; avoid 24-bit sequences.
export COLORTERM=256color
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

# Allow colored output even when a command is conservative about detecting a
# TTY. NO_COLOR takes precedence over the other color variables, so remove it.
unset NO_COLOR
export CLICOLOR=1
export CLICOLOR_FORCE=1

# zmx creates the session on first connect and restores it on reconnect.
# Do not put this command directly in .zshrc: zmx's child shell sources .zshrc
# too, which would recursively attach.
exec zmx attach termius
