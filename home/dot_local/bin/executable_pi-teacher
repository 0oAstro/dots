#!/bin/sh
# Pi with the teacher profile (~/.pi/teacher), run inside the Teacher folder of the Life vault.
# With no arguments: start a new session mirrored to Teacher/Sessions/<date time>.md.
# With arguments (for example -c or -r): pass them to pi unchanged.
set -eu

vault="${PI_TEACHER_VAULT:-$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/life}"
workdir="$vault/Teacher"
mkdir -p "$workdir/Sessions" "$workdir/Knowledge" "$workdir/viz"
cd "$workdir"
export PI_CODING_AGENT_DIR="$HOME/.pi/teacher"

if [ "$#" -gt 0 ]; then
	exec pi "$@"
fi

note="$workdir/Sessions/$(date '+%Y-%m-%d %H%M').md"
touch "$note"
if [ "$(uname)" = Darwin ]; then
	encoded=$(printf '%s' "$note" | sed 's/ /%20/g')
	open -g "obsidian://open?path=$encoded" || true
fi
exec pi "/md-log $note"
