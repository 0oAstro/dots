#!/bin/sh
# Pi with the teacher profile (~/.pi/teacher), run inside the Learning vault.
# With no arguments: start a new session mirrored to Sessions/<date time>.md.
# With arguments (for example -c or -r): pass them to pi unchanged.
set -eu

vault="${PI_TEACHER_VAULT:-$HOME/Dropbox/obsidian/Learning}"
mkdir -p "$vault/.obsidian" "$vault/Sessions" "$vault/Knowledge" "$vault/Sources" "$vault/viz"
cd "$vault"
export PI_CODING_AGENT_DIR="$HOME/.pi/teacher"

if [ "$#" -gt 0 ]; then
	exec pi "$@"
fi

note="$vault/Sessions/$(date '+%Y-%m-%d %H%M').md"
touch "$note"
if [ "$(uname)" = Darwin ]; then
	encoded=$(printf '%s' "$note" | sed 's/ /%20/g')
	open -g "obsidian://open?path=$encoded" || true
fi
exec pi "/md-log $note"
