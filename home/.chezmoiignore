# Target paths chezmoi leaves alone on this machine: by OS, by the `ai` and
# `server` switches (.chezmoi.toml.tmpl), and by whether the age key exists.

.config/zsh/README.md

{{- if not (stat (joinPath .chezmoi.homeDir ".config/age/keys.txt")) }}
# No age key yet: skip the encrypted files.
.config/zsh/.zshrc.local
.ssh/config.d/*
.ssh/github
.ssh/merak-signing
.config/lazysql/config.toml
.config/beszel/beszel-agent.env
{{- end }}

# Only this host's SSH config.
{{- range $h := list "aardvark" "thunderchief" }}
{{-   if ne $h $.host }}
.ssh/config.d/{{ $h }}
{{-   end }}
{{- end }}

# Beszel agent (brew service): hosts with a hub token in .beszel/<host>.env.age.
{{- if not (stat (joinPath .chezmoi.sourceDir ".beszel" (printf "%s.env.age" .host))) }}
.config/beszel
{{- end }}

# Hemant shares aardvark's ec2-user; his git identity lives only there.
{{- if ne .host "aardvark" }}
.ssh/merak-signing
.config/git/merak-max
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# The Bitwarden SSH agent holds the signing key on macOS.
.ssh/github
# Linux only
.config/mise/conf.d/linux.toml
{{- else }}
# macOS only
Library
.config/zsh/.zprofile
.config/zsh/config/ui/clipboard.zsh
.config/ghostty
.config/karabiner
.config/herdr/launch
.config/lazysql
.config/mise/conf.d/macos.toml
.local/bin/routerctl
.local/bin/airtel-routerctl
.local/bin/routerctl_credentials.py
{{- end }}

{{- if not .ai }}
.claude
.codex
.pi
.config/mise/conf.d/ai.toml
{{- end }}

{{- if or (eq .chezmoi.os "darwin") .server }}
# Pins Codex's app-server daemon to mise's build. The ChatGPT app ships its own
# daemon on macOS; servers run Codex without one.
.codex/packages
{{- end }}

{{- if not .ai }}
# Claude Code's Bifrost proxy (servers: user_units/servers; Macs: launchd_agents).
.config/bifrost-mitm
{{- end }}

{{- if not (and .ai .server) }}
# Server-only harnesses.
.prime
.grok
.config/mise/conf.d/server.toml
{{- end }}
