# Target paths chezmoi leaves alone on this machine: by OS, by the modules
# this host is not in (their `chezmoi: {home: [...]}` in modules/<name>/module.yml),
# and by whether the age key exists.

.config/zsh/README.md

{{- if not (stat (joinPath .chezmoi.homeDir ".config/age/keys.txt")) }}
# No age key yet: skip the encrypted files.
.config/secrets/agents.env
.ssh/config.d/*
.ssh/github
.ssh/merak-signing
.config/lazysql/config.toml
.config/beszel/beszel-agent.env
{{- end }}

# Only this host's SSH config.
{{- range $h := list "aardvark" "blackbird" "thunderchief" }}
{{-   if ne $h $.host }}
.ssh/config.d/{{ $h }}
{{-   end }}
{{- end }}

# Beszel agent (brew service): hosts with a hub token in .beszel/<host>.env.age.
{{- if not (stat (joinPath .chezmoi.sourceDir ".beszel" (printf "%s.env.age" .host))) }}
.config/beszel
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# The Bitwarden SSH agent holds the signing key on macOS.
.ssh/github
# Linux only
.config/mise/conf.d/linux.toml
{{- else }}
# macOS only
Library
.ssh/config.d/macs
.ssh/keys
.config/zsh/.zprofile
.config/zsh/config/ui/clipboard.zsh
.config/ghostty
.config/lazysql
.config/mise/conf.d/macos.toml
{{- end }}

# Home paths of the modules this host is not in.
{{- template "module-paths" (dict "key" "home" "ctx" .) }}

{{- if not .harnesses }}
# Tooling that every harness shares.
.config/mise/conf.d/ai.toml
.config/mise/conf.d/skill-profile.toml
.config/mise/skill-profile
{{- end }}

