# Target paths chezmoi leaves alone on this machine: by OS, by the `server`
# switch, the modules and the harnesses (.chezmoi.toml.tmpl), and by whether
# the age key exists.

.config/zsh/README.md

{{- if not (stat (joinPath .chezmoi.homeDir ".config/age/keys.txt")) }}
# No age key yet: skip the encrypted files.
.config/zsh/.zshrc.local
.ssh/config.d/*
.ssh/github
.ssh/merak-signing
.config/lazysql/config.toml
.config/beszel/beszel-agent.env
{{- end }}

# Only this host's SSH config.
{{- range $h := list "aardvark" "blackbird" "thunderchief" }}
{{-   if ne $h $.host }}
.ssh/config.d/{{ $h }}
{{-   end }}
{{- end }}

# Beszel agent (brew service): hosts with a hub token in .beszel/<host>.env.age.
{{- if not (stat (joinPath .chezmoi.sourceDir ".beszel" (printf "%s.env.age" .host))) }}
.config/beszel
{{- end }}

# Hemant shares aardvark's ec2-user; his git identity lives only there.
{{- if ne .host "aardvark" }}
.ssh/merak-signing
.config/git/merak-max
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# The Bitwarden SSH agent holds the signing key on macOS.
.ssh/github
# Linux only
.config/mise/conf.d/linux.toml
{{- else }}
# macOS only
Library
.ssh/config.d/macs
.ssh/keys
.config/zsh/.zprofile
.config/zsh/config/ui/clipboard.zsh
.config/ghostty
.config/lazysql
.config/mise/conf.d/macos.toml
{{- end }}

{{- if not (has "input" (get . "modules" | default list)) }}
# Karabiner's config follows the input module.
.config/karabiner
{{- end }}

{{- if not (has "games" (get . "modules" | default list)) }}
# CrossOver and NotProton upkeep follows the games module.
.local/bin/crossover-sync
.local/bin/cmas-apply
.local/bin/cmas.sh
{{- end }}

{{- /* Agent harnesses: each has conf.d/harness-<name>.toml and the paths below. */ -}}
{{- $harnessPaths := dict
      "claude" (list ".claude" ".config/bifrost-mitm")
      "pi" (list ".pi" ".local/bin/pi-teacher" ".config/mise/conf.d/pi-global-tools.toml")
      "hermes" (list)
      "prime" (list ".prime")
      "cursor" (list) }}
{{- range $name, $paths := $harnessPaths }}
{{-   if not (has $name $.harnesses) }}
.config/mise/conf.d/harness-{{ $name }}.toml
{{-     range $paths }}
{{ . }}
{{-     end }}
{{-   end }}
{{- end }}

{{- if not .harnesses }}
# Tooling that every harness shares.
.config/mise/conf.d/ai.toml
.config/mise/conf.d/skill-profile.toml
.config/mise/skill-profile
{{- end }}
