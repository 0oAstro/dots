{{- /*
  Machine profile. Answers are stored in ~/.config/chezmoi/chezmoi.toml;
  rerun `chezmoi init` to change them.
*/ -}}
{{- /* Not .chezmoi.hostname: it resolves through /etc/hosts, where blocklists remap 127.0.0.1. */ -}}
{{- $host := output "uname" "-n" | trim | lower | splitList "." | first -}}

{{- /* Two switches; everything else follows the OS. Known hosts skip the prompts. */ -}}
{{- $ai := true -}}
{{- $server := false -}}
{{- if eq $host "aardvark" -}}
{{-   $server = true -}}
{{- else if ne $host "thunderchief" -}}
{{-   $ai = promptBoolOnce . "ai" "Set up the coding agents (Claude Code, Codex, Pi)" true -}}
{{-   $server = promptBoolOnce . "server" "Always-on server (Claude Remote Control service)" false -}}
{{- end -}}

encryption = "age"
# chezmoi's own age, so decrypting never depends on an installed age binary.
useBuiltinAge = true

[age]
    identity = {{ joinPath .chezmoi.homeDir ".config/age/keys.txt" | quote }}
    recipient = "age1vk7hgt7l9zhatyepgyfwkwss3phz3xt76r2xag0q4afyhf46zp6qn7xr6p"

[diff]
    pager = "delta"
    exclude = ["scripts"]

[git]
    autoCommit = false
    autoPush = false

[data]
    host = {{ $host | quote }}
    ai = {{ $ai }}
    server = {{ $server }}

