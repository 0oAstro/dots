{{- /*
  Machine profile. Ansible decides it from the host's groups in
  ansible/inventory.yml and runs `chezmoi init --promptBool server=…
  --promptString modules=…,harnesses=…`; a manual `chezmoi init` asks instead.
*/ -}}
{{- /* Not .chezmoi.hostname: it resolves through /etc/hosts, where blocklists remap 127.0.0.1. */ -}}
{{- $host := output "uname" "-n" | trim | lower | splitList "." | first -}}

{{- /* The prompt text is also the --prompt* key, so keep it one word. */ -}}
{{- $server := promptBool "server" false -}} {{- /* always-on host */ -}}
{{- /* The host's agent harnesses, comma-separated (ansible/inventory.yml). */ -}}
{{- $harnesses := promptString "harnesses" "claude,pi" | splitList "," | compact -}}
{{- /* The host's inventory modules, comma-separated (ansible/inventory.yml). */ -}}
{{- $modules := promptString "modules" "" | splitList "," | compact -}}

encryption = "age"
# chezmoi's own age, so decrypting never depends on an installed age binary.
useBuiltinAge = true

[age]
    identity = {{ joinPath .chezmoi.homeDir ".config/age/keys.txt" | quote }}
    recipient = "age1vk7hgt7l9zhatyepgyfwkwss3phz3xt76r2xag0q4afyhf46zp6qn7xr6p"

[diff]
    pager = "delta"
    exclude = ["scripts"]

[git]
    autoCommit = false
    autoPush = false

[data]
    host = {{ $host | quote }}
    server = {{ $server }}
    modules = {{ $modules | toToml }}
    harnesses = {{ $harnesses | toToml }}

