{{- /*
  Machine profile: the host's modules (modules/<name>/module.yml lists each
  module's hosts). Ansible runs `chezmoi init --promptString modules=…`; a
  manual `chezmoi init` asks instead.
*/ -}}
{{- /* Not .chezmoi.hostname: it resolves through /etc/hosts, where blocklists remap 127.0.0.1. */ -}}
{{- $host := output "uname" "-n" | trim | lower | splitList "." | first -}}

{{- /* The prompt text is also the --prompt* key, so keep it one word. */ -}}
{{- $modules := promptString "modules" "claude,pi" | splitList "," | compact | sortAlpha -}}

{{- /* Derived from the modules: the servers module, and modules with `harness: true`. */ -}}
{{- $harnesses := list -}}
{{- range $modules -}}
{{-   $file := joinPath $.chezmoi.sourceDir ".." "modules" . "module.yml" -}}
{{-   if stat $file -}}
{{-     if dig . "vars" "chezmoi" "harness" false (include $file | fromYaml) -}}
{{-       $harnesses = append $harnesses . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

encryption = "age"
# chezmoi's own age, so decrypting never depends on an installed age binary.
useBuiltinAge = true

[age]
    identity = {{ joinPath .chezmoi.homeDir ".config/age/keys.txt" | quote }}
    recipient = "age1vk7hgt7l9zhatyepgyfwkwss3phz3xt76r2xag0q4afyhf46zp6qn7xr6p"

[diff]
    pager = "delta"
    exclude = ["scripts"]

[git]
    autoCommit = false
    autoPush = false

[data]
    host = {{ $host | quote }}
    server = {{ has "servers" $modules }}
    modules = {{ $modules | toToml }}
    harnesses = {{ $harnesses | toToml }}

