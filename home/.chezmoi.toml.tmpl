{{- /*
  Machine profile. Ansible decides it from the inventory (ansible/group_vars,
  chezmoi_data) and runs `chezmoi init --promptBool ai=…,server=…`; a manual
  `chezmoi init` asks instead.
*/ -}}
{{- /* Not .chezmoi.hostname: it resolves through /etc/hosts, where blocklists remap 127.0.0.1. */ -}}
{{- $host := output "uname" "-n" | trim | lower | splitList "." | first -}}

{{- /* Two switches; everything else follows the OS. */ -}}
{{- /* The prompt text is also the --promptBool key, so keep it one word. */ -}}
{{- $ai := promptBool "ai" true -}} {{- /* Claude Code, Codex, Pi */ -}}
{{- $server := promptBool "server" false -}} {{- /* always-on host */ -}}

encryption = "age"
# chezmoi's own age, so decrypting never depends on an installed age binary.
useBuiltinAge = true

[age]
    identity = {{ joinPath .chezmoi.homeDir ".config/age/keys.txt" | quote }}
    recipient = "age1vk7hgt7l9zhatyepgyfwkwss3phz3xt76r2xag0q4afyhf46zp6qn7xr6p"

[diff]
    pager = "delta"
    exclude = ["scripts"]

[git]
    autoCommit = false
    autoPush = false

[data]
    host = {{ $host | quote }}
    ai = {{ $ai }}
    server = {{ $server }}

