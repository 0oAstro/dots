#!/usr/bin/env bash
set -euo pipefail
: "${ASDF_INSTALL_PATH:?Mise did not set ASDF_INSTALL_PATH}"
: "${ASDF_INSTALL_VERSION:?Mise did not set ASDF_INSTALL_VERSION}"
plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source_version="$(<"$plugin_dir/version")"
if [[ "$ASDF_INSTALL_VERSION" != "$source_version" ]]; then
  printf 'requested pi-global-tools@%s, source is %s\n' "$ASDF_INSTALL_VERSION" "$source_version" >&2
  exit 1
fi
if ! command -v npm >/dev/null 2>&1; then
  printf 'pi-global-tools requires Mise-managed Node.js and npm on PATH\n' >&2
  exit 1
fi
staging="$(mktemp -d "${ASDF_INSTALL_PATH}.staging.XXXXXX")"
trap 'rm -rf "$staging"' EXIT
cp -a "$plugin_dir/package/." "$staging/"
mkdir -p "$staging/bin"
(
  cd "$staging/firecrawl-web"
  npm ci --omit=dev --include=optional --ignore-scripts --no-audit --no-fund
)
mkdir -p "$ASDF_INSTALL_PATH"
cp -a "$staging/." "$ASDF_INSTALL_PATH/"
