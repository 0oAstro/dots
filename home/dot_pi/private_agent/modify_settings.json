{{- /* chezmoi:modify-template */ -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- range $key := list "subagents" "firecrawl-web" }}{{ $_ := unset $current $key }}{{ end -}}
{{- includeTemplate "merge" (dict "current" (toJson $current) "managed" (includeTemplate "pi-settings.json" .) "format" "json") -}}
