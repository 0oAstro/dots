{{- /* chezmoi:modify-template */ -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- range $key := list "subagents" "skills" }}{{ $_ := unset $current $key }}{{ end -}}
{{- /* Pi saves this file without a final newline. */ -}}
{{- includeTemplate "merge" (dict "current" (toJson $current) "managed" (includeTemplate "pi-settings.json" .) "format" "json" "keep" (list "defaultModel" "defaultProvider" "defaultThinkingLevel" "theme" "defaultProjectTrust" "enabledModels" "modelThinkingLevels" "defaultTools")) | trimSuffix "\n" -}}
