# Third-party repos chezmoi clones on first apply and updates with
# `chezmoi update --refresh-externals` (fast-forward only).

{{- range $name, $url := dict "tpm" "tmux-plugins/tpm" "tmux-smooth-scroll" "azorng/tmux-smooth-scroll" "kanagawa-tmux" "obergodmar/kanagawa-tmux" }}

[".config/tmux/plugins/{{ $name }}"]
    type = "git-repo"
    url = "https://github.com/{{ $url }}.git"
    clone.args = ["--depth", "1"]
    pull.args = ["--ff-only"]
{{- end }}
{{- if eq .chezmoi.os "darwin" }}

# IoskeleyMono Term Nerd Font. Homebrew's font-ioskeley-mono lacks the Term build.
{{- range $w := list "Thin" "ExtraLight" "Light" "SemiLight" "Regular" "Medium" "SemiBold" "Bold" "ExtraBold" "Heavy" }}
{{-   range $i := list "" "Italic" }}
{{-     $style := ternary "Italic" (print $w $i) (and (eq $w "Regular") (eq $i "Italic")) }}

["Library/Fonts/IoskeleyMonoTermNerdFontMono-{{ $style }}.ttf"]
    type = "archive-file"
    url = "https://github.com/ahatem/IoskeleyMono/releases/download/v2.1.0/IoskeleyMono-Term-NerdFont.zip"
    path = "Normal/IoskeleyMonoTermNerdFontMono-{{ $style }}.ttf"
{{-   end }}
{{- end }}
{{- end }}
{{- if has "pi" .harnesses }}

# Teaching extensions for the pi-teacher profile: 0oAstro/learn, a fork of amosblomqvist/learn
# (no license, so not vendored) with a 1-cell md-log status icon.
[".pi/teacher/vendor/learn"]
    type = "git-repo"
    url = "https://github.com/0oAstro/learn.git"
    clone.args = ["--depth", "1"]
    pull.args = ["--ff-only"]
{{- end }}

{{- /*
  Fonts: each module's `chezmoi: {fonts: [...]}` names branches of the private
  0oAstro/fonts repo, one family per branch. git reads GitHub credentials
  through mise's gh shim, which a fresh machine gets from this apply's mise
  step, so fonts arrive on the next apply.
*/ -}}
{{- if stat (joinPath .chezmoi.homeDir ".local/share/mise/shims/gh") }}
{{-   $fontDir := ternary "Library/Fonts" ".local/share/fonts" (eq .chezmoi.os "darwin") }}
{{-   range .modules }}
{{-     $file := joinPath $.chezmoi.sourceDir ".." "modules" . "module.yml" }}
{{-     if stat $file }}
{{-       range dig . "vars" "chezmoi" "fonts" list (include $file | fromYaml) }}

["{{ $fontDir }}/{{ . }}"]
    type = "git-repo"
    url = "https://github.com/0oAstro/fonts.git"
    clone.args = ["--depth", "1", "--single-branch", "--branch", "{{ . }}"]
    pull.args = ["--ff-only"]
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
