[user]
{{- if eq .host "blackbird" }}
	# Hemant's Mac: merak-max everywhere, signed with his own key; gh is logged in as him.
	name = merak-max
	email = 181515478+merak-max@users.noreply.github.com
	signingKey = ~/.ssh/github_hemant
{{- else }}
	name = 0oAstro
	email = 79555780+0oAstro@users.noreply.github.com
	signingKey = {{ if eq .chezmoi.os "darwin" }}ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJfml6YGLlOvm7VICn5K/G05N6JkHVLtWtpDL7ejvlvB{{ else }}~/.ssh/github{{ end }}
{{- end }}

[commit]
	gpgSign = true
	verbose = true

[tap]
	gpgSign = true

[tag]
	gpgSign = true
	sort = version:refname

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[core]
	excludesFile = ~/.config/git/ignore
	pager = delta

[interactive]
	diffFilter = delta --color-only

[diff]
	algorithm = histogram

[merge]
	tool = diffview
	conflictstyle = diff3

[mergetool]
	prompt = false
	keepBackup = false

[mergetool "diffview"]
	cmd = nvim -n -c "DiffviewOpen" "$MERGE"

[pull]
	rebase = true
	ff = only

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autosquash = true
	autostash = true

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[init]
	defaultBranch = master

[branch]
	sort = -committerdate

[log]
	date = iso

[transfer]
	fsckObjects = true

[receive]
	fsckObjects = true

[color]
	ui = auto

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

{{- if .server }}
[safe]
	directory = /opt/git/repos/polymarket.git
	directory = /opt/git/repos/zdots.git
{{- end }}

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[alias]
	a = add
	b = branch
	c = commit
	ca = commit --amend
	cm = commit -m
	co = checkout
	d = diff
	ds = diff --staged
	p = push
	pf = push --force-with-lease
	pl = pull
	l = log
	r = rebase
	s = status --short
	ss = status
	forgor = commit --amend --no-edit
	graph = log --all --decorate --graph --oneline
	oops = checkout --

{{- if eq .chezmoi.os "darwin" }}

# Drop the system osxkeychain helper; GitHub credentials come from gh below.
[credential]
	helper =
{{- end }}

# GitHub HTTPS credentials come from mise's gh (its active login). Not
# `gh auth setup-git`: that pins a versioned gh path mise later prunes.
[credential "https://github.com"]
	helper =
	helper = !$HOME/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !$HOME/.local/share/mise/shims/gh auth git-credential

# Route GitHub SSH remotes through those HTTPS credentials.
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
[url "https://gist.github.com/"]
	insteadOf = git@gist.github.com:
	insteadOf = ssh://git@gist.github.com/
{{- if eq .host "aardvark" }}

# Hemant shares this ec2-user. Repos under ~/hemant/ commit, sign and push as
# merak-max. Last, so its credential helper replaces the one above.
[includeIf "gitdir:~/hemant/"]
	path = merak-max
{{- end }}
