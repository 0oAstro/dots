map cmd+ctrl+left send_text all \x1b[1;13D
map cmd+1 send_text all \x1b[49;9u
map cmd+2 send_text all \x1b[50;9u
map cmd+3 send_text all \x1b[51;9u
map cmd+4 send_text all \x1b[52;9u
map cmd+5 send_text all \x1b[53;9u
