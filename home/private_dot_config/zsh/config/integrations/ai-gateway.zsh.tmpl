# Pi/Prime: 1h Anthropic prompt cache (default 5m), matching Claude Code; 24h on
# OpenAI where the provider supports it.
export PI_CACHE_RETENTION=long
{{- if .ai }}

# Route Claude Code through Bifrost while it still talks to api.anthropic.com,
# so the claude.ai login, Remote Control and other first-party-only features
# keep working. The bifrost-mitm proxy (~/.config/bifrost-mitm; a user unit on
# servers, a launchd agent on Macs) sends model calls to Bifrost and passes
# everything else through. Do not set ANTHROPIC_AUTH_TOKEN here; it replaces
# the claude.ai login. Bypass for one run with `command claude`.
if [[ -n ${BIFROST_VIRTUAL_KEY:-} ]]; then
  claude() {
    local proxy=http://127.0.0.1:18899
    # Off the tailnet or with the proxy down, go direct, and without the key.
    if ! curl -sf -m1 -o /dev/null -x $proxy https://bifrost.shau.me/health; then
      print -u2 "claude: Bifrost proxy unreachable, going direct"
      command claude "$@"
      return
    fi
    ANTHROPIC_CUSTOM_HEADERS="x-bf-vk: $BIFROST_VIRTUAL_KEY" HTTPS_PROXY=$proxy \
      NODE_EXTRA_CA_CERTS=$HOME/.mitmproxy/mitmproxy-ca-cert.pem command claude "$@"
  }
fi
{{- end }}
