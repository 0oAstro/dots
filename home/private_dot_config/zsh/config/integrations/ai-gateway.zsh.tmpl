# Pi/Prime: 1h Anthropic prompt cache (default 5m), matching Claude Code; 24h on
# OpenAI where the provider supports it.
export PI_CACHE_RETENTION=long
{{- if .server }}

# Servers route Claude Code through Bifrost while it still talks to
# api.anthropic.com, so Remote Control and other first-party-only features keep
# working. The bifrost-mitm user unit (~/.config/bifrost-mitm) sends model calls
# to Bifrost and passes everything else through. Do not set ANTHROPIC_AUTH_TOKEN
# here; it replaces the claude.ai login. Bypass for one run with `HTTPS_PROXY= claude`.
if [[ -n ${BIFROST_VIRTUAL_KEY:-} ]]; then
  export ANTHROPIC_CUSTOM_HEADERS="x-bf-vk: $BIFROST_VIRTUAL_KEY"
  claude() {
    HTTPS_PROXY=http://127.0.0.1:18899 NODE_EXTRA_CA_CERTS=$HOME/.mitmproxy/mitmproxy-ca-cert.pem command claude "$@"
  }
fi
{{- end }}
