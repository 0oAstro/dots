# Palette indexes, so colors follow Ghostty's light/dark Kanagawa pair.
# 19-20 come from the "Plus" Ghostty themes.
typeset -g ZDOTS_THEME_PATINA=kanagawa-ansi
typeset -g ZDOTS_COLOR_GREY=8
typeset -g ZDOTS_COLOR_RED=1
typeset -g ZDOTS_COLOR_YELLOW=3
typeset -g ZDOTS_COLOR_BLUE=4
typeset -g ZDOTS_COLOR_MAGENTA=5
typeset -g ZDOTS_COLOR_CYAN=6
typeset -g ZDOTS_COLOR_WHITE=7
typeset -g ZDOTS_COLOR_GREEN=2
typeset -g ZDOTS_COLOR_ORANGE=19
typeset -g ZDOTS_COLOR_FG=-1
typeset -g ZDOTS_COLOR_SELECTION=20
