# Docker Monitor Configuration
# https://github.com/amir20/dtop/blob/master/config.example.yaml
#
# aardvark runs the containers; other machines watch it over SSH. `local` uses
# the active Docker CLI context (the Unix socket at /var/run/docker.sock).
hosts:
  - host: {{ if eq .host "aardvark" }}local{{ else }}ssh://ec2-user@aardvark{{ end }}

icons: unicode
all: false
sort: uptime
