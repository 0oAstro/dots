theme = light:Kanagawa Lotus Plus,dark:Kanagawa Dragon Plus
font-family = "IoskeleyMonoTerm Nerd Font Mono"
font-size = 14
# macos-icon = xray
macos-titlebar-proxy-icon = hidden
macos-window-buttons = hidden
cursor-style = block
window-padding-x = 10
window-padding-y = 10

custom-shader = shaders/cursor_warp.glsl

background-opacity = 0.85
background-blur = macos-glass-regular

macos-option-as-alt = true
clipboard-read = allow
copy-on-select = false
clipboard-paste-protection = false
mouse-hide-while-typing = true
shell-integration-features = no-cursor
bell-features = no-system,no-audio,no-attention,no-title,no-border
window-save-state = never
quit-after-last-window-closed = true
confirm-close-surface = false
auto-update = download
auto-update-channel = tip

quick-terminal-size = 50%
quick-terminal-position = top
quick-terminal-animation-duration = 0
# Physical backtick key, so the global shortcut is layout-independent.
keybind = global:cmd+alt+Backquote=toggle_quick_terminal

keybind = super+r=reload_config

# Cmd+Left and Cmd+Right go to the start and end of the line, not Ctrl+A.
keybind = super+arrow_left=csi:H
keybind = super+arrow_right=csi:F
keybind = escape=unbind
