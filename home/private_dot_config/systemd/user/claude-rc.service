[Unit]
Description=Claude Code Remote Control in the home directory
After=network-online.target

[Service]
WorkingDirectory=%h
# Interactive zsh puts the mise-managed claude on PATH.
ExecStart=/usr/bin/zsh -ic 'claude remote-control --name home'
KillSignal=SIGINT
TimeoutStopSec=20
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
