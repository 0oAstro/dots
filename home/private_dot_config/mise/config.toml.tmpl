# Global mise settings. Tools live in conf.d/ (core, ai, macos, linux).
# `mise use -g` writes here; move anything worth keeping into conf.d.

[settings]
# Hold new releases for 24h as a supply-chain safety window, except for
# agent harnesses, which should update immediately.
minimum_release_age = "24h"
minimum_release_age_excludes = [
  "claude-code",
  "aqua:openai/codex",
  "aqua:earendil-works/pi",
  "http:prime-agent",
  "http:cursor",
  "npm:t3",
  "herdr",
]

[settings.npm]
package_manager = "npm"

[settings.github]
# Authenticated GitHub API calls: no rate limits on `mise install`.
# Call the installed gh, never the shim: the shim runs mise, which needs this
# credential to resolve gh's version, so a cold cache recurses into a fork bomb.
credential_command = "sh -c '$HOME/.local/share/mise/installs/aqua-cli-cli/latest/gh_*/bin/gh auth token -h github.com'"
{{- if eq .chezmoi.os "darwin" }}

[env]
MISE_RUSTUP_HOME = "{{ "{{" }}env.HOME{{ "}}" }}/.local/share/rustup"
MISE_CARGO_HOME = "{{ "{{" }}env.HOME{{ "}}" }}/.local/share/cargo"
{{- end }}
