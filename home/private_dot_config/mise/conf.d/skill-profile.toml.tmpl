[plugins]
skill-profile = "{{ .chezmoi.homeDir }}/.config/mise/skill-profile"

[tools.skill-profile]
version = "{{ includeTemplate "skill-profile-version" . }}"
bin_path = "bin"
depends = ["http:pstack", "http:emil-skills", "http:mattpocock-skills", "uv"]

[hooks]
postinstall = '''
profile=$("$HOME/.local/bin/mise" where skill-profile)
if [ -x "$profile/bin/skill-profile" ]; then
  "$profile/bin/skill-profile" sync
{{ if has "cursor" .harnesses }}
  "$profile/bin/skill-profile" cursor-sync
{{ end }}
  if [ -x "$HOME/.local/share/mise/installs/http-hermes/latest/bin/hermes" ]; then
    "$profile/bin/skill-profile" hermes-sync
  fi
fi
'''
