# chezmoi:template:left-delimiter="{%" right-delimiter="%}"
# ml — model hubs, datasets and local speech-to-text.

[tools]
"pipx:huggingface-hub" = "latest"
"pipx:kaggle" = "latest"
{%- if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64") %}

# Pinned to b5130 (kept from previous config).
[tools."github:ggml-org/whisper.cpp"]
version = "b5130"
asset_pattern = "whisper-bin-ubuntu-arm64.tar.gz"
bin_path = "whisper-bin-ubuntu-arm64"
filter_bins = "whisper-cli"
{%- end %}
