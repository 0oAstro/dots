# chezmoi:template:left-delimiter="{%" right-delimiter="%}"
{%- $mac := eq .chezmoi.os "darwin" -%}
# cloud — provider CLIs and deploy tools.

[tools]
aws-cli = { version = "latest", symlink_bins = "true" }
vercel = { version = "latest", allow_builds = ["esbuild"], trust_policy_excludes = ["undici"] }
{%- if $mac %}
azure-cli = { version = "latest", uvx_args = "--prerelease=allow" }
# Use Neon's Node-based compatibility CLI; the standalone macOS release is x86_64-only.
"npm:neonctl" = "latest"
{%- else %}
azure-cli = "latest"
azd = "latest"
gcloud = "latest"
neonctl = "latest"
"npm:firebase-tools" = "latest"
"npm:cf" = "latest"
{%- end %}
