# Cursor's agent CLI. Only cursor-agent goes on PATH: dist-package also ships
# its own node and rg, which must not shadow the real ones.
[tools."http:cursor"]
version = "latest"
url = "https://downloads.cursor.com/lab/{{ "{{" }} version {{ "}}" }}/{{ if eq .chezmoi.os "darwin" }}darwin{{ else }}linux{{ end }}/{{ if eq .chezmoi.arch "arm64" }}arm64{{ else }}x64{{ end }}/agent-cli-package.tar.gz"
version_list_url = "https://cursor.com/install"
version_regex = 'lab/(\d{4}\.\d{2}\.\d{2}-[0-9A-Za-z]+)'
bin_path = "dist-package/bin"
postinstall = 'mkdir -p "$MISE_TOOL_INSTALL_PATH/dist-package/bin" && ln -sf ../cursor-agent "$MISE_TOOL_INSTALL_PATH/dist-package/bin/cursor-agent"'
