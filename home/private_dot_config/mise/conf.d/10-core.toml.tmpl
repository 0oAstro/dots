# chezmoi:template:left-delimiter="{%" right-delimiter="%}"
{%- $mac := eq .chezmoi.os "darwin" -%}
# core — languages, git, shell and CLI tools every machine gets.

[tools]
# ── Languages & runtimes ─────────────────────────────────────────────────────
bun = "latest"
go = "latest"
python = "3.14"
uv = "latest"
pnpm = "latest"
{%- if $mac %}
deno = "latest"
java = ["zulu-25", "zulu-21"]
node = "26"
ruby = "4.0"
rust = { version = "1.98", profile = "default" }
yarn = "4.18.0"
cmake = "latest"
{%- else %}
java = "corretto-21"
node = "lts"
rust = "stable"
zig = "latest"
"asdf:mise-plugins/mise-julia" = "latest"
"aqua:Kitware/CMake" = "latest"
"conda:gcc" = "latest"
"conda:clang" = "latest"
{%- end %}

# ── Dotfiles & git ───────────────────────────────────────────────────────────
chezmoi = "latest"
"aqua:cli/cli" = "latest"
"aqua:dandavison/delta" = "latest"
"aqua:git-lfs/git-lfs" = "latest"
"pipx:git-filter-repo" = "latest"

# ── Shell & terminal ─────────────────────────────────────────────────────────
herdr = "latest"
"aqua:ajeetdsouza/zoxide" = "latest"
"aqua:junegunn/fzf" = "latest"
{%- if $mac %}
neovim = "latest"
carapace = "1.7.3"
{%- else %}
"aqua:neovim/neovim" = "latest"
tmux = "latest"
zellij = "latest"
"cargo:zsh-patina" = "latest"
{%- end %}

# ── CLI utilities ────────────────────────────────────────────────────────────
"aqua:BurntSushi/ripgrep" = "latest"
"aqua:sharkdp/fd" = "latest"
"aqua:sharkdp/bat" = "latest"
"cargo:eza" = "latest"
"aqua:charmbracelet/glow" = "latest"
"go:github.com/maaslalani/fast" = "latest"
"github:AlDanial/cloc" = { version = "latest", asset_pattern = "cloc-{{ version }}.pl", bin = "cloc" }
"aqua:amir20/dtop" = "latest"
"aqua:fastfetch-cli/fastfetch" = "latest"
"cargo:pokeget" = "latest"
{%- if $mac %}
"cargo:hyperfine" = "latest"
"github:vercel-labs/fx" = "latest"
"npm:@ytspar/hctl" = "latest"
# Native Finder Trash, Put Back support, and compatibility with the existing rm=trash alias.
"github:sindresorhus/macos-trash" = { version = "3.1.0", asset_pattern = "trash.zip" }
{%- else %}
"aqua:jqlang/jq" = "latest"
"aqua:bootandy/dust" = "latest"
"aqua:sharkdp/hyperfine" = "latest"
"aqua:aristocratos/btop" = "latest"
"pipx:trash-cli" = "latest"
{%- end %}
{%- if $mac %}

# Force the Apple-silicon release; Aqua's default manifest selected the Intel asset.
[tools."github:bootandy/dust"]
version = "1.2.5"
asset_pattern = "dust-v{{ version }}-aarch64-apple-darwin.tar.gz"
bin_path = "dust-v{{ version }}-aarch64-apple-darwin"
bin = "dust"

[tools."github:projectdiscovery/httpx"]
version = "latest"
asset_pattern = "httpx_{{ version }}_macOS_arm64.zip"
bin = "httpx"

[tools."github:tectonic-typesetting/tectonic"]
version = "latest"
asset_pattern = "tectonic-{{ version }}-aarch64-apple-darwin.tar.gz"
bin = "tectonic"
{%- end %}
