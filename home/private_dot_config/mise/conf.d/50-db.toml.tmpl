# chezmoi:template:left-delimiter="{%" right-delimiter="%}"
{%- $mac := eq .chezmoi.os "darwin" -%}
{%- $triple := printf "%s-%s" (eq .chezmoi.arch "arm64" | ternary "aarch64" "x86_64") ($mac | ternary "apple-darwin" "unknown-linux-gnu") -%}
# db — database clients.

[tools]
"vfox:jdx/vfox-mysql" = { version = "latest", filter_bins = "mysql*" }

[tools."github:theseus-rs/postgresql-binaries"]
version = "{% if $mac %}18.6.0{% else %}latest{% end %}"
asset_pattern = "postgresql-{{ version }}-{% $triple %}.tar.gz"
bin_path = "postgresql-{{ version }}-{% $triple %}/bin"
filter_bins = "psql"
{%- if $mac %}

[tools."github:jorgerojas26/lazysql"]
version = "latest"
asset_pattern = "lazysql_Darwin_arm64.tar.gz"
bin = "lazysql"
{%- end %}
