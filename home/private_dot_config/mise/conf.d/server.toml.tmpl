# Agent harnesses only servers run; ~/.prime and ~/.grok follow the same rule
# (.chezmoiignore). Servers are Linux, so Cursor ships its Linux build only.

# Prime agent, the native Rust build from GitHub releases. The binary reads
# its runtime and skills from the same directory, so only bin/ goes on PATH,
# with `prime` and `prime-agent` both linked to it.
[tools."github:PrimeIntellect-ai/prime-agent"]
version = "latest"
asset_pattern = "prime-agent-*-{{ if eq .chezmoi.os "darwin" }}darwin{{ else }}linux{{ end }}-{{ if eq .chezmoi.arch "arm64" }}arm64{{ else }}x64{{ end }}.tar.gz"
bin_path = "bin"
postinstall = '''
mkdir -p "$MISE_TOOL_INSTALL_PATH/bin"
ln -sf ../prime-agent "$MISE_TOOL_INSTALL_PATH/bin/prime-agent"
ln -sf ../prime-agent "$MISE_TOOL_INSTALL_PATH/bin/prime"
'''

# Grok Build. `grok update` is off (~/.grok/config.toml); mise owns upgrades.
[tools."http:grok"]
version = "latest"
version_list_url = "https://x.ai/cli/stable"
bin = "grok"
platforms.macos-arm64.url = "https://x.ai/cli/grok-{{ "{{" }} version {{ "}}" }}-macos-aarch64.gz"
platforms.linux-arm64.url = "https://x.ai/cli/grok-{{ "{{" }} version {{ "}}" }}-linux-aarch64.gz"
platforms.linux-x64.url = "https://x.ai/cli/grok-{{ "{{" }} version {{ "}}" }}-linux-x86_64.gz"

# Cursor's agent CLI. Only cursor-agent goes on PATH: dist-package also ships
# its own node and rg, which must not shadow the real ones.
[tools."http:cursor"]
version = "latest"
url = "https://downloads.cursor.com/lab/{{ "{{" }} version {{ "}}" }}/linux/{{ if eq .chezmoi.arch "arm64" }}arm64{{ else }}x64{{ end }}/agent-cli-package.tar.gz"
version_list_url = "https://cursor.com/install"
version_regex = 'lab/(\d{4}\.\d{2}\.\d{2}-[0-9A-Za-z]+)'
bin_path = "dist-package/bin"
postinstall = 'mkdir -p "$MISE_TOOL_INSTALL_PATH/dist-package/bin" && ln -sf ../cursor-agent "$MISE_TOOL_INSTALL_PATH/dist-package/bin/cursor-agent"'
