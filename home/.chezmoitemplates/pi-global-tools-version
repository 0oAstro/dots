{{- $root := joinPath .chezmoi.sourceDir "dot_pi/private_agent/package-sources/pi-global-tools" -}}
{{- $package := joinPath $root "package" -}}
{{- $content := "" -}}
{{- range $path := glob (joinPath $package "**") -}}
  {{- if not (index (stat $path) "isDir") -}}
    {{- $content = printf "%s%s\n" $content (include $path) -}}
  {{- end -}}
{{- end -}}
{{- range $path := list (joinPath $root "bin/executable_install") (joinPath $root "bin/executable_list-all") -}}
  {{- $content = printf "%s%s\n" $content (include $path) -}}
{{- end -}}
{{- sha256sum $content -}}
