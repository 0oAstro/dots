{
  "theme": "light/dark",
  "editorPaddingX": 1,
  "defaultProvider": "amazon-bedrock",
  "defaultModel": "us.anthropic.claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "amazon-bedrock/us.anthropic.claude-opus-5-5"
  ],
  "modelThinkingLevels": {
    "amazon-bedrock/us.anthropic.claude-opus-5-5": "high"
  },
  "packages": [
    "~/.local/share/mise/installs/npm-tintinweb-pi-subagents/latest/lib/node_modules/@tintinweb/pi-subagents",
    {
      "source": "git:github.com/0oAstro/pi-firecrawl-web",
      "extensions": []
    }
  ],
  "extensions": [
    "-builtin:llama.cpp",
    "-builtin:mcp",
    "-builtin:codemode",
    "-builtin:tool-search",
    "~/.pi/teacher/vendor/learn/extensions/quiz.ts",
    "~/.pi/teacher/vendor/learn/extensions/ask-user-question.ts",
    "~/.pi/teacher/vendor/learn/extensions/md-log.ts"
  ],
  "firecrawl-web": {
    "fetchModel": "azure/gpt-6-luna"
  },
  "compaction": {
    "enabled": true
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "cacheWarming": "idle",
  "quietStartup": "header",
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "ask",
  "hideThinkingBlock": true,
  "httpIdleTimeoutMs": 900000,
  "retry": {
    "provider": {
      "timeoutMs": 960000
    }
  },
  "tuiMode": "fullscreen"
}
