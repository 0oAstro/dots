{
  "theme": "light/dark",
  "defaultProvider": "bifrost",
  "defaultModel": "anthropic/claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "bifrost/azure/fw-kimi-k3",
    "bifrost/azure/fw-glm-5.3-flash",
    "bifrost/anthropic/claude-haiku-5-5",
    "bifrost/azure/gpt-6.1-sol",
    "bifrost/anthropic/claude-opus-5-5",
    "bifrost/anthropic/claude-fable-5-1",
    "bifrost/azure/gpt-6-astra"
  ],
  "packages": [
    "~/.local/share/mise/installs/npm-aliou-pi-processes/latest/lib/node_modules/@aliou/pi-processes",
    {
      "source": "~/.local/share/mise/installs/http-pstack/latest",
      "skills": ["!principle-*","!arena","!swarm","!thermos","!thermo-nuclear-review","!thermo-nuclear-code-quality-review","!reflect","!ketchup","!bro","!what-did-i-get-done","!setup-pstack","!poteto-help","!automate-me","!babysit","!correct","!interrogate","!make-pr-easy-to-review","!maintain-verification-skill","!create-verification-skill"]
    },
    "~/.local/share/mise/installs/npm-sting8k-pi-vcc/latest/lib/node_modules/@sting8k/pi-vcc",
    "~/.local/share/mise/installs/npm-pi-intercom/latest/lib/node_modules/pi-intercom",
    "~/.local/share/mise/installs/npm-rea-agents/latest/lib/node_modules/rea-agents",
    "~/.local/share/mise/installs/pi-global-tools/{{ includeTemplate "pi-global-tools-version" . }}"
  ],
  "compaction": {
    "enabled": true,
    "modelOverrides": {
      "bifrost/azure/gpt-6.1-sol": { "reserveTokens": 40960 },
      "bifrost/azure/gpt-6-astra": { "reserveTokens": 40960 }
    }
  },
  "firecrawl-web": {
    "fetchModel": "bifrost/anthropic/claude-haiku-5-5"
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "showCacheMissNotices": true,
  "cacheWarming": "idle",
  "quietStartup": "header",
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "hideThinkingBlock": true,
  "modelThinkingLevels": {
    "bifrost/anthropic/claude-fable-5-1": "xhigh",
    "bifrost/anthropic/claude-opus-5-5": "medium",
    "bifrost/azure/gpt-6-astra": "medium",
    "bifrost/azure/gpt-6.1-sol": "high",
    "bifrost/azure/fw-glm-5.3-flash": "max",
    "bifrost/azure/fw-kimi-k3": "max",
    "bifrost/anthropic/claude-haiku-5-5": "xhigh"
  },
  "httpIdleTimeoutMs": 900000,
  "retry": {
    "provider": {
      "timeoutMs": 960000
    }
  },
  "extensions": [
    "-builtin:llama.cpp"
  ],
  "codemode": {
    "mode": "only"
  },
  "tuiMode": "fullscreen",
  "defaultTools": [
    "+codemode",
    "+tool_search"
  ]
}
