{
  "syncClaudeAiPlugins": false,
  "syncClaudeAiSkills": false,
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SHELL": "/bin/bash",
    "HTTPS_PROXY": ""
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "disableClaudeAiConnectors": true,
  "hooks": {
    "SessionStart": []
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false
  },
  "skillOverrides": {
    "artifact-capabilities": "user-invocable-only",
    "artifact-diagramming": "user-invocable-only",
    "batch": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "claude-in-chrome": "user-invocable-only",
    "code-review": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "debug": "user-invocable-only",
    "deep-research": "user-invocable-only",
    "design": "user-invocable-only",
    "design-sync": "user-invocable-only",
    "doctor": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "loop": "user-invocable-only",
    "run": "user-invocable-only",
    "run-skill-generator": "user-invocable-only",
    "schedule": "user-invocable-only",
    "simplify": "user-invocable-only",
    "slides": "user-invocable-only",
    "update-config": "user-invocable-only",
    "verify": "user-invocable-only",
    "workflow-authoring": "user-invocable-only"
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "preferredNotifChannel": "ghostty",
  "switchModelsOnFlag": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  }
}
